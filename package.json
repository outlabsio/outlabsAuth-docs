{
  "name": "outlabs-auth-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "seo:generate": "bun scripts/generate-seo.mjs",
    "build": "bun run seo:generate && nuxt generate",
    "build:production": "NUXT_SITE_URL=https://auth.outlabs.io bun run seo:generate && NUXT_SITE_URL=https://auth.outlabs.io nuxt generate",
    "build:staging": "NUXT_SITE_URL=https://auth-staging.outlabs.io bun run seo:generate && NUXT_SITE_URL=https://auth-staging.outlabs.io nuxt generate",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "port:handbook": "python3 scripts/port_handbook.py",
    "deploy": "bun scripts/deploy.mjs",
    "deploy:production": "bun scripts/deploy.mjs production",
    "deploy:staging": "bun scripts/deploy.mjs staging"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.117",
    "@iconify-json/simple-icons": "^1.2.90",
    "@iconify-json/vscode-icons": "^1.2.67",
    "@nuxt/content": "^3.15.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/mcp-toolkit": "^0.18.0",
    "@nuxtjs/mdc": "^0.22.1",
    "@vueuse/core": "^14.3.0",
    "@takumi-rs/core": "^1.8.7",
    "minimark": "^0.2.0",
    "nuxt": "^4.4.8",
    "nuxt-llms": "0.2.0",
    "nuxt-og-image": "^6.7.2",
    "tailwindcss": "^4.3.2",
    "ufo": "^1.6.4",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.7",
    "wrangler": "^4.78.0"
  },
  "packageManager": "pnpm@11.13.1"
}
